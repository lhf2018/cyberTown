<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承Spring Boot父项目，简化依赖管理 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <!-- 项目基本信息 -->
    <groupId>com.cybertown</groupId>
    <artifactId>cyber-town</artifactId>
    <version>1.0.0</version>
    <name>Cyber Town</name>
    <description>赛博朋克小镇AI模拟系统</description>

    <!-- 属性定义，便于统一管理版本 -->
    <properties>
        <java.version>17</java.version>              <!-- 使用Java 17 -->
        <spring-ai.version>0.8.1</spring-ai.version> <!-- Spring AI版本 -->
    </properties>

    <!-- 项目依赖 -->
    <dependencies>
        <!-- ========== Spring Boot核心依赖 ========== -->

        <!-- Web开发依赖：包含Spring MVC、Tomcat等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA数据访问依赖：简化数据库操作 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ========== AI相关依赖 ========== -->

        <!-- Spring AI OpenAI Starter：用于调用DeepSeek（兼容OpenAI API） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai-spring-boot-starter</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <!-- ========== 数据库依赖 ========== -->

        <!-- H2内存数据库：开发测试用，无需安装，启动即用 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>  <!-- 只在运行时需要 -->
        </dependency>

        <!-- ========== 开发工具依赖 ========== -->

        <!-- Lombok：通过注解自动生成getter/setter等方法，减少样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>  <!-- 编译时使用，不打包到最终JAR -->
        </dependency>

        <!-- ========== 测试依赖 ========== -->

        <!-- Spring Boot测试框架 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>      <!-- 仅测试时使用 -->
        </dependency>
    </dependencies>

    <!-- 构建配置 -->
    <build>
        <plugins>
            <!-- Spring Boot Maven插件：支持打包为可执行JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- Maven仓库配置：Spring AI还在里程碑阶段，需要特殊仓库 -->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>  <!-- 不启用快照版本 -->
            </snapshots>
        </repository>
    </repositories>
</project>